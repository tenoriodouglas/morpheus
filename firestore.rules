rules_version = '2';

// Security rules for the Morpheus parent <-> child channel.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per child, keyed by the child's pairing code.
    //
    // Access model: authenticated (Anonymous Auth) + trust-on-first-use
    // membership. The first two devices that touch the document — the child and
    // the parent who scanned/typed the pairing code — claim membership by adding
    // their uid to `members`. Once two members exist, no one else can read or
    // write, even if they learn the pairing code. Enable Authentication >
    // Sign-in method > Anonymous in the Firebase console.
    match /families/{childId} {
      function members() {
        return ('members' in resource.data) ? resource.data.members : [];
      }
      function isMember() {
        return request.auth != null && request.auth.uid in members();
      }
      function bootstrapping() {
        // No members yet, or still room for the second (parent+child) device.
        return members().size() < 2;
      }

      allow create: if request.auth != null;
      allow read:   if isMember() || (request.auth != null && members().size() == 0);
      allow update: if isMember() || (request.auth != null && bootstrapping());
      allow delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Note: this TOFU model caps a family at two devices (one child + one parent).
// To support multiple parents, raise the bootstrap size and have an existing
// member add the new uid.
