rules_version = '2';

// Security rules for the Morpheus parent <-> child channel.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per child, keyed by the child's pairing code.
    // Requires an authenticated caller — the app signs in with Anonymous Auth,
    // so enable Authentication > Sign-in method > Anonymous in the Firebase
    // console. Effective access is gated by knowing the child's pairing code
    // (childId), which the child generates as an 8-char random value.
    match /families/{childId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Hardening note: for stronger isolation between families, add a membership
// model — e.g. store the parent and child uids on each document at pairing time
// and require request.auth.uid to be in that set. That requires a small pairing
// handshake and is a good next step for a production release.
