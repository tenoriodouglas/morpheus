rules_version = '2';

// Security rules for the Morpheus parent <-> child channel.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per child, keyed by the child's pairing code.
    //
    // Access model: any signed-in (Anonymous Auth) device that knows the child's
    // pairing code may read/write that child's document. The pairing code (shown
    // as a QR + 8-char code on the child, scanned/typed on the parent) is the
    // shared secret.
    //
    // NOTE: we deliberately do NOT tie access to the anonymous uid. Anonymous uids
    // change whenever the app is reinstalled or its data is cleared, so a
    // uid-based "membership" model permanently locks a device out of its own
    // family document after a reinstall — which broke live status, SOS, extra-time
    // and remote blocking. Gating on "authenticated + knows the pairing code"
    // keeps it simple and robust. Enable Authentication > Sign-in method >
    // Anonymous in the Firebase console.
    match /families/{childId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
