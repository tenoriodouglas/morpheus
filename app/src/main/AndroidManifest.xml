<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking / VPN based internet blocking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep enforcement alive and survive reboots. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ask the user to exempt Morpheus from battery optimization so enforcement,
         the background watchdog and live location keep running when the app is
         closed (like a messaging app). Requested with the child's consent. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Precise schedule toggling at bedtime start/end. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Notifications: required, and used for the transparent "managed device"
         status that Google Play policy requires for monitoring apps. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Per-app daily limits: read foreground time. Granted via Settings
         (Usage access), not a runtime prompt. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Location: shows the guardian where the child device is and powers the
         geofence (safe-area) alerts. Requested in-app only after a prominent
         disclosure, background access is asked for separately, and the child
         device permanently displays the managed-device notice. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required from Android 14 for a foreground service that reads location. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- QR pairing scan (parent). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Audio calls between parent and child (WebRTC). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Package visibility (Android 11+) for the apps we can cut internet from
         per-app (VpnService.addAllowedApplication resolves each package). Mirrors
         KnownApps; no QUERY_ALL_PACKAGES needed. -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.kwai.video" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.discord" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.roblox.client" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:name=".MorpheusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Morpheus"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR scanner pinned to portrait (the library default rotates with the
             sensor). stateNotNeeded avoids re-creating it on rotation events. -->
        <activity
            android:name=".ui.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Morpheus"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="LockedOrientationActivity" />

        <!-- Full-screen notice shown when a blocked app is opened (fallback path). -->
        <activity
            android:name=".ui.BlockedAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.Morpheus" />

        <!-- Note: the accessibility-based app blocker was removed for the first
             Play release (its policy requires a demo video + prominent disclosure).
             Internet blocking (VPN) and anti-uninstall (Device Admin) are unaffected;
             per-app blocking still works on Device Owner installs. -->

        <!-- Device Owner provisioning (scanned as a QR during setup wizard). -->
        <activity
            android:name=".provisioning.ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".provisioning.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Device Admin: prevents uninstall by the child while active and
             lets the parent enforce policy. Strong (unremovable) mode requires
             Device Owner provisioning via ADB — see README. -->
        <receiver
            android:name=".admin.MorpheusDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- Local VPN that drops all traffic during blocked windows. -->
        <service
            android:name=".vpn.BlockingVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces parental internet-schedule by running a local no-route VPN during blocked hours." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Supervisor that keeps the schedule applied. -->
        <service
            android:name=".service.GuardianService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the parental-control schedule enforced and shows the transparent managed-device status." />
        </service>

        <!-- Firebase Cloud Messaging: receives remote commands from the parent. -->
        <service
            android:name=".remote.MorpheusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Re-arm schedule after reboot / app update. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Fires at the start/end of each blocked window. -->
        <receiver
            android:name=".receiver.ScheduleAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
